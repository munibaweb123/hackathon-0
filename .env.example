# Silver Tier Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Claude API (Required for reasoning loop)
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# =============================================================================
# Gmail OAuth (Required for Gmail watcher and email actions)
# Get credentials from Google Cloud Console: https://console.cloud.google.com/
# =============================================================================
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# =============================================================================
# LinkedIn OAuth (Required for LinkedIn watcher and posting)
# Get credentials from LinkedIn Developer Portal: https://developer.linkedin.com/
# =============================================================================
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/callback

# =============================================================================
# Server Configuration
# =============================================================================
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
DASHBOARD_PORT=3000

# =============================================================================
# Vault Configuration
# =============================================================================
VAULT_PATH=./obsidian-vault

# =============================================================================
# Watcher Configuration
# =============================================================================
GMAIL_POLLING_INTERVAL=300
LINKEDIN_POLLING_INTERVAL=900
WHATSAPP_POLLING_INTERVAL=30

# =============================================================================
# Claude Configuration
# =============================================================================
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_TIMEOUT=60000

# =============================================================================
# Feature Flags
# =============================================================================
MOCK_MODE=false
DEBUG=false

# =============================================================================
# Gold Tier: Master Encryption Key (Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# =============================================================================
GOLD_MASTER_KEY=your-32-byte-base64-key-here

# =============================================================================
# Gold Tier: Xero OAuth (Get from Xero Developer Portal: https://developer.xero.com/)
# =============================================================================
XERO_CLIENT_ID=your-xero-client-id
XERO_CLIENT_SECRET=your-xero-client-secret
XERO_REDIRECT_URI=http://localhost:8001/xero/callback

# =============================================================================
# Gold Tier: Meta/Facebook OAuth (Get from Meta Developer Portal: https://developers.facebook.com/)
# =============================================================================
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=http://localhost:8002/meta/callback

# =============================================================================
# Gold Tier: Twitter OAuth (Get from Twitter Developer Portal: https://developer.twitter.com/)
# =============================================================================
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret
TWITTER_REDIRECT_URI=http://localhost:8002/twitter/callback

# =============================================================================
# Gold Tier: MCP Server Ports
# =============================================================================
COORDINATOR_PORT=8000
FINANCIAL_MCP_PORT=8001
SOCIAL_MCP_PORT=8002
COMMS_MCP_PORT=8003

# =============================================================================
# Gold Tier: Master Encryption Key (Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# =============================================================================
GOLD_MASTER_KEY=your-32-byte-base64-key-here

# =============================================================================
# Gold Tier: Xero OAuth (Get from Xero Developer Portal: https://developer.xero.com/)
# =============================================================================
XERO_CLIENT_ID=your-xero-client-id
XERO_CLIENT_SECRET=your-xero-client-secret
XERO_REDIRECT_URI=http://localhost:8001/xero/callback

# =============================================================================
# Gold Tier: Meta/Facebook OAuth (Get from Meta Developer Portal: https://developers.facebook.com/)
# =============================================================================
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=http://localhost:8002/meta/callback

# =============================================================================
# Gold Tier: Twitter OAuth (Get from Twitter Developer Portal: https://developer.twitter.com/)
# =============================================================================
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret
TWITTER_REDIRECT_URI=http://localhost:8002/twitter/callback

# =============================================================================
# Gold Tier: MCP Server Ports
# =============================================================================
COORDINATOR_PORT=8000
FINANCIAL_MCP_PORT=8001
SOCIAL_MCP_PORT=8002
COMMS_MCP_PORT=8003
