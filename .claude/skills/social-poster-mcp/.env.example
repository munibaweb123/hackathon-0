# Social Poster MCP Server — Environment Variables
# Copy to .env and fill in your credentials.

# ---- Obsidian Vault ----
VAULT_PATH=../../obsidian-vault

# ---- Facebook (Meta Graph API) ----
FACEBOOK_PAGE_ID=your-page-id
FACEBOOK_ACCESS_TOKEN=your-page-access-token

# ---- Instagram (Meta Graph API) ----
# Instagram Business Account ID (from Facebook Page → Instagram settings)
INSTAGRAM_USER_ID=your-ig-business-account-id
INSTAGRAM_ACCESS_TOKEN=your-meta-access-token

# ---- Twitter/X (API v2 + OAuth 1.0a) ----
TWITTER_API_KEY=your-consumer-api-key
TWITTER_API_SECRET=your-consumer-api-secret
TWITTER_ACCESS_TOKEN=your-user-access-token
TWITTER_ACCESS_TOKEN_SECRET=your-user-access-token-secret
TWITTER_BEARER_TOKEN=your-app-bearer-token

# ---- Instagram Media Hosting (optional) ----
# Instagram API requires images at a public URL.
# If posting from vault Attachments/, set this to the URL prefix
# where images are served (e.g., https://yourdomain.com/media/).
# MEDIA_HOST_URL=https://yourdomain.com/media/
