# ============================================================================
# Vault .gitignore — generated by vault-sync skill
# ============================================================================
# This file prevents sensitive data from being synced via Git.
# Customize as needed for your environment.
# ============================================================================

# ---- Secrets & credentials ----
.env
.env.local
.env.production
.env.*.local
!.env.example

**/credentials*.json
**/token*.json
**/service-account*.json
**/*.key
**/*.pem
**/*.p12
**/*.pfx

# ---- Session data (agent-local) ----
**/session.json
**/session_data/
**/cookies.json
**/*.session

# ---- Obsidian workspace (causes merge conflicts) ----
.obsidian/workspace.json
.obsidian/workspaces.json
.obsidian/workspace-mobile.json

# ---- Transient / agent-local folders ----
processing/
retry-queue/

# ---- OS files ----
**/.DS_Store
**/Thumbs.db
**/desktop.ini

# ---- Editor / IDE ----
**/*.swp
**/*.swo
**/*~
.vscode/
.idea/

# ---- Large binaries (sync separately) ----
# Uncomment if you want to exclude large attachments:
# Attachments/*.pdf
# Attachments/*.zip
