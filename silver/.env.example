# Silver Tier — Environment Variables
# Copy this file to the project root as .env:
#   cp silver/.env.example .env

# ============================================
# Gmail OAuth (shared by gmail-watcher + email-sender-mcp)
# ============================================
# Download from Google Cloud Console → Credentials → OAuth 2.0
GMAIL_CREDENTIALS_PATH=./credentials.json
# Auto-created after first OAuth flow
GMAIL_TOKEN_PATH=./token.json

# ============================================
# Anthropic API Key (for Claude CLI / orchestrator)
# ============================================
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ============================================
# Vault Path
# ============================================
VAULT_PATH=./obsidian-vault

# ============================================
# WhatsApp (optional)
# ============================================
# Session data stored locally after QR code scan
WHATSAPP_SESSION_DIR=./whatsapp-session

# ============================================
# Email Sender MCP (Node.js — optional overrides)
# ============================================
# MCP_GMAIL_CLIENT_ID=your-client-id
# MCP_GMAIL_CLIENT_SECRET=your-client-secret
